#bt_refrescar{
background-color: #578294;
border: none;
border-radius: 15px;
color: #FFFFFF;
font: 77 10px &quot;Arial Black&quot;;
padding: 5px 15px;
}
/*   efecto del raton   al buscar   */
#bt_refrescar:hover{
background-color: #457B9D;
}


