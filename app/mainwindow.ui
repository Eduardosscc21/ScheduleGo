QTableWidget, QTableView{
background-color: #C3D2D9 ;
color: #2D3748;
gridline-color: #E2E8F0;
border: 1px solid #E2E8F0;
border-radius: 5px;
font-size: 13px;
}



/*Titulos de la tabla */
QHeaderView, QTableCornerButton:section{
background-color: #457B9D;
border: none;
}
QHeaderView:section{
background-color: #457B9D;
color: #093266;

font-weight: bold;
