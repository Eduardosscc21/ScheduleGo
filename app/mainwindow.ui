}
/*     las cajas de texto de nrc y ciclo    */
#materia_choque, #materia_choque_2{
background-color: #FFFFFF;
border: none;
border-bottom: 2px solid #457B9D;
color: #1D3557;
font: 10pt &quot;Arial&quot;;
padding: 2px;
border-radius: 5px;

}
/*    se oscurece la linea     */
#materia_choque:focus, #materia_choque_2:focus{
border-bottom: 2px solid #1D3557;
}
/*     btn buscar    */
#signal_choque_materias{
background-color: #1D3557;
border: none;
border-radius: 15px;
color: #FFFFFF;
font: 77 10px &quot;Arial Black&quot;;
padding: 5px 15px;
}
/*   efecto del raton   al buscar   */
#signal_choque_materias:hover{
background-color: #457B9D;
}
/*     efecto al darle clic al buscar    */
#signal_choque_materias:pressed{
background-color: #E2E8F0;
color: #1D3557;
}

