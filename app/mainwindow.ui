                <property name="styleSheet">
                 <string notr="true">#page_eliminar{
background-color: #B2C8D6 /*#C3D0DE*/;
border-radius: 10px;
}

#page_eliminar QLabel{
background-color: #FFFFFF;
color: #1D3557 !important;
font: 77 10pt &quot;Arial Black&quot;;
border-radius: 5px;
}

/* caja de texto del nrc  */
#materia_eliminar{
background-color: #FFFFFF;
border: none;
border-bottom: 2px solid #457B9D;
color: #1D3557;
font: 10pt &quot;Arial&quot;;
padding: 2px;
border-radius: 5px;
}
/*  la linea azul se oscurece*/
#materia_eliminar:focus{
border-bottom: 2px solid #1D3557;
}
/* los btnes de buscar y eliminar */
#bt_buscar_eliminar, #signal_eliminar{
background-color: #1D3557;
border: none;
border-radius: 12px;
color: #FFFFFF;
font: 77 10pt &quot;Arial Black&quot;;
padding: 6px 18px;
}
/* los btnes se aclaran un poquito */
#bt_buscar_eliminar:hover, #signal_eliminar:hover{
background-color: #457B9D;
color: #FFFFFF;
}
/*  */
#bt_buscar_eliminar:pressed, #signal_eliminar:pressed{
background-color: #E2E8F0;
color: #1D3557;
}

#tabla_borrar{
background-color: #C3D2D9;
border: 1px solid #E2E8F0;
gridline-color: #E2E8F0;
