QFrame QPushButton{
background-color: transparent;
color: #61c0bf;
font-weight: bold;
font-size: 11pt;
font-family: &quot;Segoe UI Emoji&quot;, &quot;Arial Black&quot;;
text-align: left;
padding-left : 15px;
border-radius: 12px;
min-height: 45px;
border: none;
}

QFrame QPushButton:hover{
background-color: rgba(255,255,255,0.08) ;
}

QFrame QPushButton:pressed,
QFrame QPushButton:checked{
background-color: #3A7D9B ;
color: #FFFFFF ;
border-style: solid;
border-width: 1.3px ;
border-color:  #163242 #163242 ;
}





