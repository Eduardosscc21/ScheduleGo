                <property name="styleSheet">
                 <string notr="true">#page_choque_materias{
background-color: #B2C8D6;
border-radius: 10px;
}
/*    los textos de nrc y ciclo     */
#nrc_choque_materias, #nrc_choque_materias_2{
color: #1D3557;
font: 77 10px &quot;Arial Black&quot;;
